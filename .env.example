# ----------------------------------------------------------------------------
# Environment variables  (see SETUP.md for the full walkthrough)
# ----------------------------------------------------------------------------
# The template RUNS WITHOUT ANY of these — submissions just log to the server
# console until you wire up a backend. Fill in only the integrations you use.
#
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in the values for the services you use.
# 3. Restart `npm run dev` after changing it.
#
# .env.local is gitignored — NEVER commit real keys.
# Variable names below match what the Bookee code reads (see SETUP.md).
# ----------------------------------------------------------------------------


# === App =====================================================================
# Public base URL of the site (used for Stripe redirects + OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# === Notion — store leads / bookings ========================================
# Account: https://www.notion.so  ·  Integration: https://www.notion.so/my-integrations
# Demo path:
NOTION_SECRET=<your-notion-integration-secret>
NOTION_DATABASE_ID=<your-notion-database-id>
# Paid "setup call" path (only if you run the second path):
NOTION_SETUP_DATABASE_ID=<your-setup-database-id>
# NOTION_SETUP_SECRET=   # only if the setup DB uses a different integration


# === Dograh — AI voice agent that calls the lead ============================
# Account / docs: https://dograh.com
DOGRAH_API_KEY=<your-dograh-api-key>
# DOGRAH_DEMO_AGENT_ID=    # optional — pin the demo agent UUID
DOGRAH_SETUP_AGENT_ID=<your-setup-agent-uuid>   # paid path
# DOGRAH_SETUP_API_KEY=    # only if the setup agent is a different Dograh login


# === Twilio — phone number the agent calls from =============================
# Account: https://www.twilio.com/try-twilio  ·  Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=+15551234567


# === Google Calendar — write confirmed bookings (OAuth) =====================
# Google Cloud Console: https://console.cloud.google.com (enable "Google Calendar API")
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REFRESH_TOKEN=<your-google-refresh-token>
GOOGLE_CALENDAR_ID=you@yourdomain.com
# GOOGLE_DEMO_CALENDAR_ID=   # optional — separate "Bookee Demos" calendar


# === Stripe — collect the setup deposit on /book-setup ======================
# Account: https://dashboard.stripe.com/register  ·  Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>


# === Anthropic — (used by the original for summarizing the lead) ===========
# Account: https://console.anthropic.com
ANTHROPIC_API_KEY=<your-anthropic-api-key>
