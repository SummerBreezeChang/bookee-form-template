# ──────────────────────────────────────────────────────────────────────────
# Bookee — environment variables
# Copy to .env.local for local dev, and set the same keys in your host (Vercel).
# Vars marked (optional) can be left blank — the feature they gate is skipped.
# The app RUNS with none set; each integration turns on when its keys appear.
# ──────────────────────────────────────────────────────────────────────────

# ── Notion (lead CRM) ──────────────────────────────────────────────────────
# Internal integration secret: https://www.notion.so/my-integrations
NOTION_SECRET=<your-notion-integration-secret>
# Demo-leads database id (the long id in the DB URL, everything before "?")
NOTION_DATABASE_ID=<your-demo-database-id>
# Paid setup-calls live in a SEPARATE database (optional — needed only for the paid path)
NOTION_SETUP_SECRET=                 # (optional) defaults to NOTION_SECRET
NOTION_SETUP_DATABASE_ID=            # (optional) required only if you enable paid deposits

# ── Google Calendar (OAuth2) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REFRESH_TOKEN=<from-scripts/get-google-refresh-token.mjs>
GOOGLE_CALENDAR_ID=primary                       # calendar real bookings land on
GOOGLE_DEMO_CALENDAR_ID=                          # (optional) separate calendar for free demos

# ── Dograh (AI voice agent) ────────────────────────────────────────────────
# Use each agent's PUBLIC Trigger-Path UUID — NOT the internal agent id.
DOGRAH_API_KEY=<your-dograh-api-key>             # shared fallback for both agents
DOGRAH_DEMO_AGENT_ID=<your-demo-agent-trigger-uuid>
DOGRAH_DEMO_API_KEY=                              # (optional) defaults to DOGRAH_API_KEY
DOGRAH_SETUP_AGENT_ID=                            # (optional) needed for the paid path
DOGRAH_SETUP_API_KEY=                             # (optional) defaults to DOGRAH_API_KEY

# ── Stripe (deposit checkout — optional, only for the paid path) ────────────
STRIPE_SECRET_KEY=<your-stripe-secret-key>       # sk_test_... in test mode
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

# ── Twilio (optional — phone validation only) ──────────────────────────────
# Used only for Lookup v2 phone validation. Outbound CALLING is configured
# inside Dograh, not here — so the `twilio` npm package is NOT required.
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# ── Anthropic (optional — lead research) ───────────────────────────────────
# One-sentence business summary from the lead's website. Leave blank to skip.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_MODEL=                               # (optional) defaults to a current Claude Sonnet

# ── Site ───────────────────────────────────────────────────────────────────
# (optional) Overrides the Checkout success/cancel redirect origin.
# If unset it's derived from the request host — use your WWW domain in prod.
NEXT_PUBLIC_SITE_URL=https://www.yoursite.com
